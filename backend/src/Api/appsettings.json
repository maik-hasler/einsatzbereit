{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "http://keycloak:8080/realms/einsatzbereit",
    "ExternalHost": "localhost:8080",
    "InternalHost": "keycloak:8080",
    "ValidIssuers": [
      "http://localhost:8080/realms/einsatzbereit",
      "http://keycloak:8080/realms/einsatzbereit"
    ]
  },
  "ConnectionStrings": {
    "einsatzbereit": "Host=postgres;Database=einsatzbereit;Username=postgres;Password=postgres"
  },
  "Keycloak": {
    "BaseUrl": "http://keycloak:8080",
    "Realm": "einsatzbereit",
    "ClientId": "backend",
    "ClientSecret": "backend-secret"
  },
  "RateLimiting": {
    "Read": {
      "AuthenticatedPermitLimit": 200,
      "AnonymousPermitLimit": 60,
      "WindowSeconds": 60
    },
    "Write": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    }
  }
}

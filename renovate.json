{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "* 6 * * *"
  ],
  "timezone": "Europe/Berlin",
  "dependencyDashboard": true,
  "automerge": false,
  "labels": [
    "dependencies",
    "renovate"
  ],
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "matchManagers": [
        "nuget"
      ],
      "matchDepNames": [
        "Aspire.AppHost.Sdk"
      ],
      "rangeStrategy": "replace"
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchDepNames": [
        "Aspire.AppHost.Sdk"
      ],
      "matchUpdateTypes": [
        "pin"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchPackageNames": [
        "TUnit{/,}**"
      ],
      "groupName": "TUnit",
      "groupSlug": "tunit"
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchPackageNames": [
        "Microsoft.AspNetCore.OpenApi",
        "Microsoft.OpenApi"
      ],
      "groupName": "OpenAPI",
      "groupSlug": "openapi",
      "prBodyNotes": [
        "**`Microsoft.OpenApi` is a transitive pin, not a real dependency.** It exists only because every `Microsoft.AspNetCore.OpenApi` 10.0.x depends on `Microsoft.OpenApi` 2.0.0, which is inside GHSA-v5pm-xwqc-g5wc - and `TreatWarningsAsErrors` turns the resulting NU1903 into a restore failure.",
        "**If this PR bumps `Microsoft.AspNetCore.OpenApi` to 10.0.11 or later**, check whether it now depends on `Microsoft.OpenApi` >= 2.7.5 (the upstream fix is dotnet/aspnetcore#67543). If it does, delete the `Microsoft.OpenApi` `PackageVersion` line from `backend/Directory.Packages.props` as part of this PR - the pin has done its job. See the comment above that line."
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^(keycloak/)?AGENTS\\.md$/",
        "/^docs/Architecture/src/.*\\.adoc$/",
        "/^docs/Architecture/images/.*\\.puml$/",
        "/^README\\.md$/",
        "/^backend/src/Aspire/AppHost/AppHost\\.cs$/",
        "/^\\.github/workflows/dotnet\\.yml$/",
        "/^\\.github/workflows/publish\\.yml$/"
      ],
      "matchStrings": [
        "Keycloak (?<currentValue>[\\d]+\\.[\\d]+\\.[\\d]+)",
        "quay\\.io/keycloak/keycloak:(?<currentValue>[\\d]+\\.[\\d]+\\.[\\d]+)",
        "quay\\.io/keycloak/keycloak\",\\s*\"(?<currentValue>[\\d]+\\.[\\d]+\\.[\\d]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "quay.io/keycloak/keycloak"
    }
  ]
}

# Reference for docker-compose.yml. The real .env is generated by the
# deploy-staging job (publish.yml) from GitHub Environment secrets and copied
# to the host on each RC deploy - you do not place this file by hand.
# Required secrets in the `staging` GitHub Environment:
#   POSTGRES_USER, POSTGRES_PASSWORD, KEYCLOAK_ADMIN_USER, KEYCLOAK_ADMIN_PASSWORD,
#   MINIO_ROOT_USER, MINIO_ROOT_PASSWORD, SMTP_HOST, SMTP_USERNAME, SMTP_PASSWORD,
#   SMTP_FROM_ADDRESS
# (Plus deploy creds: STAGING_SSH_KEY/HOST/USER, GHCR_USERNAME, GHCR_TOKEN.)
#
# Traefik runs as a separate host-level container (shared across projects on
# the same Hetzner box) - its ACME and dashboard auth secrets live with that
# stack, not here.

# PostgreSQL credentials. Used by Postgres, Keycloak, and the backend.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Keycloak bootstrap admin (master realm).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# MinIO root credentials. Used by MinIO and the backend's Storage__AccessKey/SecretKey.
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# SMTP relay mailbox for outgoing mail - shared by Keycloak (verifyEmail/
# resetPasswordAllowed) and the backend (engagement notifications). SMTP_PORT
# defaults to 587 (STARTTLS) and SMTP_FROM_NAME to "Einsatzbereit" if unset.
SMTP_HOST=change-me
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_FROM_ADDRESS=change-me
SMTP_FROM_NAME=Einsatzbereit

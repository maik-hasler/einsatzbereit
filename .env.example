# Reference for docker-compose.yml. The real .env is generated by the
# deploy-staging job (publish.yml) from GitHub Environment secrets and copied
# to the host on each RC deploy - you do not place this file by hand.
# Required secrets in the `staging` GitHub Environment:
#   POSTGRES_USER, POSTGRES_PASSWORD, KEYCLOAK_ADMIN_USER, KEYCLOAK_ADMIN_PASSWORD,
#   KEYCLOAK_BACKEND_SECRET, MINIO_ROOT_USER, MINIO_ROOT_PASSWORD,
#   MINIO_APP_ACCESS_KEY, MINIO_APP_SECRET_KEY, SMTP_HOST, SMTP_PORT,
#   SMTP_USERNAME, SMTP_PASSWORD, SMTP_FROM_ADDRESS, SMTP_FROM_NAME,
#   GRAFANA_ADMIN_PASSWORD, ALERT_NOTIFICATION_EMAIL, OFFSITE_S3_ENDPOINT,
#   OFFSITE_S3_ACCESS_KEY, OFFSITE_S3_SECRET_KEY
#   (GRAFANA_ADMIN_USER optional)
# (Plus deploy creds: STAGING_SSH_KEY/HOST/USER, STAGING_SSH_HOST_KEY,
#  GHCR_USERNAME, GHCR_TOKEN.)
#
# Traefik runs as a separate host-level container (shared across projects on
# the same Hetzner box) - its ACME and dashboard auth secrets live with that
# stack, not here. Grafana is routed the same way at grafana.maik-hasler.de,
# so that DNS record has to exist and point at the staging host before the
# route resolves, same as the other *.maik-hasler.de subdomains below.

# PostgreSQL credentials. Used by Postgres, Keycloak, and the backend.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Keycloak bootstrap admin (master realm).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# MinIO root credentials. Used by MinIO itself and by minio-init to bootstrap
# the bucket-scoped app account below - the backend no longer authenticates
# with these (#1353).
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# Bucket-scoped MinIO service account for the backend's Storage__AccessKey/
# SecretKey (created by minio-init on first deploy, see docker-compose.yml).
# Generate a random access key/secret pair - these are not MinIO's root
# credentials, so a leaked value can only read/write the "einsatzbereit"
# bucket, not administer the whole MinIO instance.
MINIO_APP_ACCESS_KEY=change-me
MINIO_APP_SECRET_KEY=change-me

# Backend's Keycloak client secret. Must be a generated random value (not a
# committed literal) - shared between the realm import (resolves the
# "${KEYCLOAK_BACKEND_SECRET}" placeholder in keycloak/realms/einsatzbereit-realm.json)
# and the backend's own Keycloak__ClientSecret. See keycloak/AGENTS.md.
KEYCLOAK_BACKEND_SECRET=change-me

# SMTP relay mailbox for outgoing mail - shared by Keycloak (verifyEmail/
# resetPasswordAllowed) and the backend (engagement notifications). All six
# values are required (no defaults).
SMTP_HOST=change-me
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_FROM_ADDRESS=change-me
SMTP_FROM_NAME=Einsatzbereit

# Recipient address for Prometheus Alertmanager's email notifications
# (docker-compose.yml's alertmanager-config, #1081) - routed over the same
# SMTP relay as above, so no separate mail credentials are needed here.
ALERT_NOTIFICATION_EMAIL=change-me

# Grafana admin login. GRAFANA_ADMIN_USER defaults to "admin" if unset.
# These only apply the FIRST time Grafana boots against an empty
# grafana_data volume - this is Grafana's own documented behavior, not
# something this repo controls. Changing GRAFANA_ADMIN_PASSWORD after that
# has no effect on the live account; recover via
# `.github/workflows/reset-staging.yml` (wipes grafana_data along with
# Postgres/MinIO) if you ever need to change it post-bootstrap.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Off-host mirror target for the offsite-backup service (#1087) - a Hetzner
# Object Storage bucket distinct from the MINIO_* application storage above.
# OFFSITE_S3_ENDPOINT is the region endpoint (e.g.
# https://fsn1.your-objectstorage.com), not the bucket's own virtual-hosted
# subdomain - the bucket name itself is OFFSITE_S3_BUCKET below, which
# defaults to "einsatzbereit-backups" in docker-compose.yml and isn't a
# secret, so it isn't listed in the required-secrets comment above.
OFFSITE_S3_ENDPOINT=change-me
OFFSITE_S3_ACCESS_KEY=change-me
OFFSITE_S3_SECRET_KEY=change-me

# Whether the backend seeds demo organizations/opportunities on startup
# (ApplicationDbContextInitializer.SeedAsync, idempotent - no-ops once any
# Organization row exists). Defaults to "false" in docker-compose.yml so a
# fresh deployment of this compose file starts empty. The staging deploy
# job (publish.yml) hardcodes this to "true" directly - not a secret, and
# not listed above - so staging keeps coming back seeded on every
# deploy/reset (#1375).
DATABASE_SEED_ON_STARTUP=false

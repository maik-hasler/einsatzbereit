# Reference for docker-compose.yml. The real .env is generated by publish.yml's
# deploy-staging job from the `staging` GitHub Environment's secrets and copied
# to the host on each RC deploy - every key below has to exist there. You do not
# place this file by hand.
#
# Deploy credentials are separate secrets that never appear in .env:
# STAGING_SSH_KEY/HOST/USER, STAGING_SSH_HOST_KEY, GHCR_USERNAME, GHCR_TOKEN.
#
# Traefik runs as a host-level container shared across projects, so its ACME and
# dashboard secrets live with that stack, not here. Grafana is routed the same
# way at grafana.maik-hasler.de, so that DNS record must exist before the route
# resolves.

# PostgreSQL credentials. Used by Postgres, Keycloak, and the backend.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Keycloak bootstrap admin (master realm).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# MinIO root credentials, used by MinIO and minio-init only - the backend
# authenticates with the bucket-scoped account below.
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# Bucket-scoped MinIO service account for the backend, created by minio-init on
# first deploy. Generate a random pair: a leak can only read/write the
# "einsatzbereit" bucket, not administer the MinIO instance.
MINIO_APP_ACCESS_KEY=change-me
MINIO_APP_SECRET_KEY=change-me

# Backend's Keycloak client secret - a generated random value, never a committed
# literal. Shared between the realm import (resolves the placeholder in
# keycloak/realms/einsatzbereit-realm.json) and the backend's own
# Keycloak__ClientSecret. See keycloak/AGENTS.md.
KEYCLOAK_BACKEND_SECRET=change-me

# SMTP relay mailbox, shared by Keycloak (verifyEmail/resetPasswordAllowed) and
# the backend (engagement notifications). All six values required, no defaults.
SMTP_HOST=change-me
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_FROM_ADDRESS=change-me
SMTP_FROM_NAME=Einsatzbereit

# Recipient for Alertmanager's email notifications, over the SMTP relay above.
ALERT_NOTIFICATION_EMAIL=change-me

# Grafana admin login (GRAFANA_ADMIN_USER defaults to "admin"). Grafana applies
# these only on its FIRST boot against an empty grafana_data volume, so changing
# the password later has no effect on the live account - recover via
# .github/workflows/reset-staging.yml, which wipes grafana_data.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Off-host mirror target for minio-backup - a Hetzner Object Storage bucket
# distinct from the MINIO_* application storage above. OFFSITE_S3_ENDPOINT is the
# region endpoint (e.g. https://fsn1.your-objectstorage.com), not the bucket's
# virtual-hosted subdomain; the bucket name is OFFSITE_S3_BUCKET, which
# docker-compose.yml defaults and which is not a secret.
OFFSITE_S3_ENDPOINT=change-me
OFFSITE_S3_ACCESS_KEY=change-me
OFFSITE_S3_SECRET_KEY=change-me

# Whether the backend seeds demo organizations/opportunities on startup
# (idempotent - no-ops once any Organization row exists). Defaults to false so a
# fresh deployment starts empty; publish.yml hardcodes "true" for staging.
DATABASE_SEED_ON_STARTUP=false

    {
      "username": "service-account-backend",
      "enabled": true,
      "serviceAccountClientId": "backend",
      "clientRoles": {
        "realm-management": [
          "manage-realm",
          "manage-users",
          "manage-organizations"
        ]
      }
    }
  ]
}

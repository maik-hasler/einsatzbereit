      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "email": "olaf@example.com",
      "firstName": "Olaf",
      "lastName": "Organisator",
      "realmRoles": [
        "user",
        "organisator"
      ],
      "credentials": [

root = true

[*]
indent_style = tab
indent_size = 4
tab_width = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

# YAML forbids tab indentation per spec; JSON conventionally uses spaces
[*.{yml,yaml,json}]
indent_style = space
indent_size = 2
